<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<connectionStrings>
		<!-- Opción 1: Autenticación de Windows (la más común si entras con tu usuario de Windows a SSMS) -->
		<add name="TandGSystem" connectionString="Server=.\SQLEXPRESS;Database=TandGSystem;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />

		<!-- Opción 2: Autenticación de SQL Server (si en SSMS usas usuario como 'sa' y contraseña)
<add name="TandGSystem" 
     connectionString="Server=localhost;Database=NombreDeTuBase;User Id=sa;Password=tu_password;TrustServerCertificate=True;" 
     providerName="System.Data.SqlClient" />
-->
	</connectionStrings>
